rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasAccessToProject(projectId) {
      let userData = getUserData();
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      
      // Admin has access to all projects
      return userData.role == 'admin' ||
             // Check if project is in user's projectIds
             projectId in userData.projectIds ||
             // Check if user is the project client
             project.clientId == request.auth.uid ||
             // Check if user is the project creator
             project.createdBy == request.auth.uid ||
             // Check if user's builderOrgId matches project's builderOrgId
             (userData.builderOrgId != null && userData.builderOrgId == project.builderOrgId);
    }
    
    function isBuilder() {
      return isSignedIn() && getUserData().role == 'builder';
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    
    function isBuilderOrDesignerOrAdmin() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'builder' || role == 'designer' || role == 'admin');
    }
    
    function belongsToBuilderOrg(orgId) {
      return isSignedIn() && getUserData().builderOrgId == orgId;
    }
    
    // Validate file size (max 10MB for images, 50MB for documents)
    function isValidImageSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    function isValidDocumentSize() {
      return request.resource.size < 50 * 1024 * 1024;
    }
    
    // Validate image file types
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isDocument() {
      return request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*');
    }
    
    // Project photos
    match /projects/{projectId}/photos/{photoId} {
      allow read: if isSignedIn() && hasAccessToProject(projectId);
      
      allow write: if isSignedIn() && 
                      hasAccessToProject(projectId) && 
                      isImage() && 
                      isValidImageSize();
    }
    
    // Project photo thumbnails
    match /projects/{projectId}/photos/thumbnails/{photoId} {
      allow read: if isSignedIn() && hasAccessToProject(projectId);
      
      // Thumbnails are generated by Cloud Functions
      allow write: if false;
    }
    
    // Builder organization options (product images)
    match /options/{fileName} {
      allow read: if isSignedIn();
      
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      
                      isImage() && 
                      isValidImageSize();
    }
    
    // Builder organization logos
    match /builderOrgs/{orgId}/logo.png {
      allow read: if isSignedIn();
      
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      (belongsToBuilderOrg(orgId) || isAdmin()) && 
                      isImage() && 
                      isValidImageSize();
    }
    
    // Message attachments
    match /messages/{projectId}/{messageId}/{attachmentId} {
      allow read: if isSignedIn() && hasAccessToProject(projectId);
      
      allow write: if isSignedIn() && 
                      hasAccessToProject(projectId) && 
                      ((isImage() && isValidImageSize()) || 
                       (isDocument() && isValidDocumentSize()));
    }
    
    // User profile photos (avatars)
    match /user_avatars/{fileName} {
      // Allow anyone to read avatars (public)
      allow read: if true;
      
      // Allow write if the filename starts with the user's ID (e.g., userId.jpg)
      allow write: if isSignedIn() && 
                      fileName.matches(request.auth.uid + '.*') &&
                      isImage() && 
                      isValidImageSize();
    }
    
    // User avatars in user-specific folders
    match /users/{userId}/avatar/{fileName} {
      // Allow anyone to read avatars (public)
      allow read: if true;
      
      // Allow users to upload their own avatar
      allow write: if isSignedIn() && 
                      request.auth.uid == userId && 
                      isImage() && 
                      isValidImageSize();
    }
    
    // User profile photos (optional feature - legacy)
    match /users/{userId}/profile.jpg {
      allow read: if isSignedIn();
      
      allow write: if isSignedIn() && 
                      request.auth.uid == userId && 
                      isImage() && 
                      isValidImageSize();
    }
    
    // Selection/Item images
    match /selections/{fileName} {
      // Allow anyone authenticated to read selection images
      allow read: if isSignedIn();
      
      // Allow builders, designers, and admins to upload selection images
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      isImage() && 
                      isValidImageSize();
    }
    
    // Paint images (paint swatch uploads)
    match /paint/{fileName} {
      // Allow anyone authenticated to read paint images
      allow read: if isSignedIn();
      
      // Allow builders, designers, and admins to upload paint images
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      isImage() && 
                      isValidImageSize();
    }

    // Cabinetry images
    match /cabinetry/{fileName} {
      // Allow anyone authenticated to read cabinetry images
      allow read: if isSignedIn();
      
      // Allow builders, designers, and admins to upload cabinetry images
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      isImage() && 
                      isValidImageSize();
    }

    // Fixture images (for room builder)
    match /fixtures/{fileName} {
      // Allow anyone authenticated to read fixture images
      allow read: if isSignedIn();
      
      // Allow builders, designers, and admins to upload fixture images
      allow write: if isBuilderOrDesignerOrAdmin() && 
                      isImage() && 
                      isValidImageSize();
    }

    // Questionnaire attachments (client uploads)
    match /questionnaire/{projectId}/{clientId}/{questionId}/{fileName} {
      allow read: if isSignedIn() && hasAccessToProject(projectId);

      // Only the client themselves can upload their questionnaire images
      allow write: if isSignedIn() &&
                      request.auth.uid == clientId &&
                      hasAccessToProject(projectId) &&
                      isImage() &&
                      isValidImageSize();
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
